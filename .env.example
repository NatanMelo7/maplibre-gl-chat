# Select one provider for this server deployment. Never expose the API key in browser code.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=

# Optional: API base URL for an OpenAI-compatible provider, such as https://openrouter.ai/api/v1.
# Usually leave empty for OpenAI, Anthropic, Gemini, or DeepSeek.
LLM_BASE_URL=
